+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { build } from "esbuild";
+
+// Run the real serializer without the browser-only global that caused the live failure.
+Reflect.deleteProperty(globalThis, "btoa");
+const bundled = await build({
+  entryPoints: [new URL("../src/plugin/api/node/operations/result.ts", import.meta.url).pathname],
+  bundle: true,
+  format: "esm",
+  platform: "neutral",
+  write: false,
