+function createRuntime(storage = new Map(), documentId = "test-document", readStored) {
+  const elements = new Map([...html.matchAll(/id="([^"]+)"/g)].map((match) => {
+    const element = new EventTarget();
+    Object.assign(element, { value: '', textContent: '', disabled: false, checked: false, classList: { toggle() {} }, removeAttribute(name) { delete this[name]; } });
+    return [match[1], element];
+  }));
+  const sockets = [];
+  const replies = new Map();
+  const timers = new Set();
+  const confirmations = [];
+  const pluginMessages = [];
+  let closed = 0;
+  let requestId = 0;
+  class Socket {
+    static OPEN = 1;
+    static CONNECTING = 0;
+    readyState = 0;
+    listeners = new Map();
+    constructor(url) { this.url = url; sockets.push(this); }
+    addEventListener(name, listener) { this.listeners.set(name, listener); }
+    emit(name, value = {}) { if (name === 'open') this.readyState = 1; return this.listeners.get(name)?.(value); }
+    send(text) { const message = JSON.parse(text); if (message.id) { replies.get(message.id)?.(message); replies.delete(message.id); } }
+    close(code = 1000) { this.readyState = 3; this.emit('close', { code }); }
+  }
+  const popupAttempts = [];
+  const window = { open() { popupAttempts.push(true); throw new Error('The host blocks iframe popups'); } };
+  const events = new Map();
+  const settle = () => new Promise((resolve) => setImmediate(resolve));
+  const ui = {
+    viewport: { visible: true },
+    show() { this.viewport.visible = true; },
+    hide() { this.viewport.visible = false; },
+    close() { closed += 1; },
+    setCloseConfirm(value) { confirmations.push(value); },
+    postMessage(message) { pluginMessages.push(message); window.onmessage?.({ data: { pluginMessage: message } }); },
+  };
+  const mg = {
+    ui, apiVersion: '1.0.0', documentId,
+    on(name, listener) { events.set(name, listener); },
+    clientStorage: {
+      async getAsync(key) { return readStored ? readStored(key) : storage.get(key); },
+      async setAsync(key, value) { storage.set(key, value); },
+      async deleteAsync(key) { storage.delete(key); },
+    },
+    showUI() {}, closePlugin() { closed += 1; },
+  };
+  const clear = (id) => { clearTimeout(id); clearInterval(id); timers.delete(id); };
+  const context = vm.createContext({
+    mg, __html__: html, window, WebSocket: Socket,
+    document: { getElementById(id) { assert.ok(elements.has(id), `Missing UI element ${id}`); return elements.get(id); } },
+    parent: { postMessage(message) { void ui.onmessage(message); } },
+    setTimeout(fn, delay) { const id = setTimeout(() => { timers.delete(id); fn(); }, delay); timers.add(id); return id; },
+    setInterval(fn, delay) { const id = setInterval(fn, delay); timers.add(id); return id; },
+    clearTimeout: clear, clearInterval: clear,
+  });
+  vm.runInContext(plugin, context);
+  vm.runInContext(script, context);
+  return {
+    ui, sockets, confirmations, pluginMessages, timers, elements, settle, popupAttempts,
+    run() { events.get("run")?.({ command: "" }); },
+    get closed() { return closed; },
+    async connect(remember = false) {
+      await settle();
+      elements.get('bridge-token').value = '0'.repeat(64);
+      elements.get('remember-connection').checked = remember;
+      elements.get('connection-form').dispatchEvent(new Event('submit', { cancelable: true }));
+      await settle();
+      sockets.at(-1).emit('open');
+    },
+    click(id) { elements.get(id).dispatchEvent(new Event('click')); },
+    request(payload) { const id = `panel-test-${++requestId}`; return new Promise((resolve) => { replies.set(id, resolve); sockets.at(-1).emit('message', { data: JSON.stringify({ type: 'request', method: 'mastergo.invoke', id, payload }) }); }); },
+    async direct(payload) { await ui.onmessage({ type: 'bridge.request', id: 'direct-test', payload }); return pluginMessages.at(-1).data; },
+    dispose() { vm.runInContext('stopConnection(false)', context); timers.forEach(clear); },
+  };
