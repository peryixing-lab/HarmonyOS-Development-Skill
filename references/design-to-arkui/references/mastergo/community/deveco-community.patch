diff --git a/mcp-server/src/confirm-pairing.ts b/mcp-server/src/confirm-pairing.ts
new file mode 100644
index 0000000..83053d0
--- /dev/null
+++ b/mcp-server/src/confirm-pairing.ts
@@ -0,0 +1,64 @@
+import { spawn } from "node:child_process";
+
+export type PairingDecision = "approved" | "denied" | "expired" | "cancelled" | "unavailable";
+
+export function confirmPairing(code: string, signal: AbortSignal): Promise<PairingDecision> {
+  if (signal.aborted) return Promise.resolve("cancelled");
+  if (!/^\d{6}$/.test(code)) return Promise.resolve("unavailable");
+  const text = `是否允许 MasterGo 插件连接本机 DevEco Code？\n\n配对码：${code}\n请确认与插件中显示的配对码一致。\n\n允许后可读取当前设计和导出资源；连接会保存在本机，之后自动连接。`;
+  const command = process.platform === "darwin" ? "/usr/bin/osascript"
+    : process.platform === "win32" ? "powershell.exe" : "zenity";
+  const args = process.platform === "darwin" ? ["-e", `
+on run argv
+  try
+    set answer to display dialog (item 1 of argv) with title "MasterGo 连接 DevEco Code" buttons {"取消", "允许连接"} default button "取消" cancel button "取消" with icon caution giving up after 120
+    if gave up of answer then return "expired"
+    if button returned of answer is "允许连接" then return "approved"
+    return "denied"
+  on error number -128
+    return "denied"
+  end try
+end run`, text] : process.platform === "win32" ? ["-NoProfile", "-NonInteractive", "-Sta", "-Command", `
+Add-Type -AssemblyName System.Windows.Forms
+$result = [System.Windows.Forms.MessageBox]::Show($env:DEVECO_PAIRING_TEXT, 'MasterGo 连接 DevEco Code', [System.Windows.Forms.MessageBoxButtons]::YesNo, [System.Windows.Forms.MessageBoxIcon]::Question, [System.Windows.Forms.MessageBoxDefaultButton]::Button2)
+if ($result -eq 'Yes') { Write-Output 'approved' } else { Write-Output 'denied' }
+`] : ["--question", "--title=MasterGo 连接 DevEco Code", `--text=${text}`,
+    "--ok-label=允许连接", "--cancel-label=取消", "--default-cancel", "--timeout=120"];
+  return new Promise((resolve) => {
+    // The dialog receives a display code, never the bridge credential.
+    const child = spawn(command, args, {
+      stdio: ["ignore", "pipe", "ignore"], shell: false,
+      env: { ...process.env, MASTERGO_BRIDGE_TOKEN: undefined,
+        ...(process.platform === "win32" ? { DEVECO_PAIRING_TEXT: text } : {}) },
+    });
+    let output = "";
+    let settled = false;
+    const finish = (decision: PairingDecision) => {
+      if (settled) return;
+      settled = true;
+      clearTimeout(timer);
+      signal.removeEventListener("abort", cancel);
+      child.stdout.destroy();
+      if (child.exitCode === null) child.kill();
+      resolve(decision);
+    };
+    const cancel = () => finish("cancelled");
+    const timer = setTimeout(() => finish("expired"), 120_000);
+    signal.addEventListener("abort", cancel, { once: true });
+    child.stdout.on("data", (bytes: Buffer) => {
+      output += bytes.toString("utf8");
+      if (output.length > 256) finish("unavailable");
+    });
+    child.once("error", () => finish("unavailable"));
+    child.once("close", (exitCode) => {
+      if (process.platform !== "darwin" && process.platform !== "win32") {
+        finish(exitCode === 0 ? "approved" : exitCode === 1 ? "denied" : exitCode === 5 ? "expired" : "unavailable");
+        return;
+      }
+      const decision = output.trim();
+      finish(exitCode === 0 && (decision === "approved" || decision === "denied" || decision === "expired")
+        ? decision : "unavailable");
+    });
+    if (signal.aborted) cancel();
+  });
+}
