diff --git a/mcp-server/src/pairing-server.ts b/mcp-server/src/pairing-server.ts
new file mode 100644
index 0000000..945dd17
--- /dev/null
+++ b/mcp-server/src/pairing-server.ts
@@ -0,0 +1,96 @@
+import { randomBytes, randomInt } from "node:crypto";
+import type { IncomingMessage, ServerResponse } from "node:http";
+import type { Duplex } from "node:stream";
+import { WebSocket, WebSocketServer } from "ws";
+import type { ServerConfig } from "./config.js";
+import type { PairingDecision } from "./confirm-pairing.js";
+
+type Pairing = {
+  socket: WebSocket;
+  controller: AbortController;
+  code: string;
+  timer: NodeJS.Timeout;
+};
+
+// Only the OS confirmation result may authorize the requesting socket.
+// Browser requests and plugin messages cannot approve a pairing.
+export class PairingServer {
+  private readonly wss = new WebSocketServer({ noServer: true, maxPayload: 1024 });
+  private readonly pending = new Map<string, Pairing>();
+  private readonly attempts: number[] = [];
+  private readonly origin: string;
+
+  constructor(
+    private readonly config: ServerConfig,
+    private readonly lifetimeMs = 120_000,
+    private readonly confirm?: (code: string, signal: AbortSignal) => Promise<PairingDecision>,
+  ) {
+    this.origin = new URL(config.mcpUrl).origin;
+  }
+
+  private local(req: IncomingMessage) {
+    return this.config.httpHost === "127.0.0.1" &&
+      req.headers.host === new URL(this.origin).host &&
+      ["127.0.0.1", "::ffff:127.0.0.1"].includes(req.socket.remoteAddress ?? "");
+  }
+
+  handleUpgrade(req: IncomingMessage, socket: Duplex, head: Buffer) {
+    if (req.url?.split("?")[0] !== "/pairing/request") return false;
+    const origin = req.headers.origin;
+    const allowedOrigin = origin === "null" || origin === undefined ||
+      /^https:\/\/(?:[a-z0-9-]+\.)*mastergo\.com$/.test(origin);
+    const now = Date.now();
+    while (this.attempts.length && this.attempts[0] < now - 60_000) this.attempts.shift();
+    if (!this.local(req) || !allowedOrigin || !this.config.bridgeToken ||
+      this.pending.size >= 1 || this.attempts.length >= 6) {
+      socket.end("HTTP/1.1 403 Forbidden\r\nConnection: close\r\n\r\n");
+      return true;
+    }
+    this.attempts.push(now);
+    this.wss.handleUpgrade(req, socket, head, (ws) => {
+      const id = randomBytes(24).toString("hex");
+      const pairing: Pairing = {
+        socket: ws,
+        controller: new AbortController(),
+        code: String(randomInt(100000, 1000000)),
+        timer: setTimeout(() => this.finish(id, "expired"), this.lifetimeMs),
+      };
+      this.pending.set(id, pairing);
+      ws.on("error", () => this.finish(id, "cancelled"));
+      ws.on("close", () => this.finish(id, "cancelled"));
+      ws.send(JSON.stringify({ type: "pairing.ready", method: "native", code: pairing.code,
+        expiresInSeconds: Math.ceil(this.lifetimeMs / 1000) }));
+      void Promise.resolve().then(() => this.confirm?.(pairing.code, pairing.controller.signal) ?? "unavailable")
+        .catch(() => "unavailable" as const).then((decision) => {
+          if (this.pending.get(id) === pairing) this.finish(id, decision);
+        });
+    });
+    return true;
+  }
+
+  async handleHttp(req: IncomingMessage, res: ServerResponse) {
+    if (!/^\/pairing(?:\/|$)/.test(req.url ?? "")) return false;
+    res.writeHead(this.local(req) ? 410 : 403, { "Content-Type": "text/plain; charset=utf-8", "Cache-Control": "no-store" });
+    res.end("首次配对已改为本机系统确认框。请返回 MasterGo，点击“连接 DevEco Code”，然后在系统确认框中允许连接。无需浏览器。 ");
+    return true;
+  }
+
+  private finish(id: string, status: PairingDecision) {
+    const pairing = this.pending.get(id);
+    if (!pairing) return;
+    this.pending.delete(id);
+    clearTimeout(pairing.timer);
+    pairing.controller.abort();
+    if (pairing.socket.readyState === WebSocket.OPEN) {
+      pairing.socket.send(JSON.stringify({ type: `pairing.${status}`,
+        ...(status === "approved" ? { token: this.config.bridgeToken } : {}) }));
+      pairing.socket.close(1000);
+    }
+  }
+
+  close() {
+    for (const id of this.pending.keys()) this.finish(id, "cancelled");
+    for (const ws of this.wss.clients) ws.terminate();
+    this.wss.close();
+  }
+}
diff --git a/mcp-server/test/connection-panel.test.ts b/mcp-server/test/connection-panel.test.ts
new file mode 100644
index 0000000..55b9d89
--- /dev/null
+++ b/mcp-server/test/connection-panel.test.ts
@@ -0,0 +1,101 @@
+import assert from "node:assert/strict";
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { createServer } from "node:net";
+import { request } from "node:http";
+import { resolve } from "node:path";
+import { setTimeout } from "node:timers/promises";
+import test from "node:test";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { StreamableHTTPClientTransport } from "@modelcontextprotocol/sdk/client/streamableHttp.js";
+import { WebSocket } from "ws";
+import { z } from "zod";
+
+const panelResult = z.object({ data: z.object({ code: z.number(), res: z.object({ connected: z.boolean(), visible: z.boolean() }), errorMsg: z.string() }) });
+
+test("connection panel MCP uses the live bridge transport without expanding the canvas allowlist", async (t) => {
+  const reservation = createServer();
+  reservation.listen(0, "127.0.0.1");
+  await once(reservation, "listening");
+  const address = reservation.address();
+  assert.ok(address && typeof address === "object");
+  const port = address.port;
+  await new Promise<void>((done, reject) => reservation.close((error) => error ? reject(error) : done()));
+  const base = `http://127.0.0.1:${port}`;
+  const token = "1".repeat(64);
+  const child = spawn(globalThis.process.execPath, [resolve("dist/index.js")], {
+    env: { ...globalThis.process.env, MCP_HTTP_HOST: "127.0.0.1", MCP_HTTP_PORT: String(port), MASTERGO_BRIDGE_TOKEN: token, DEVECO_MASTERGO_READ_ONLY: "1" },
+    stdio: "ignore",
+  });
+  const client = new Client({ name: "connection-panel-test", version: "1.0.0" });
+  let socket: WebSocket | undefined;
+  t.after(async () => {
+    await client.close();
+    if (socket && socket.readyState !== WebSocket.CLOSED) {
+      const closed = once(socket, "close"); socket.close(); await closed;
+    }
+    if (child.exitCode === null) { const exited = once(child, "exit"); child.kill("SIGTERM"); await exited; }
+  });
+  for (let attempt = 0; attempt < 100; attempt += 1) {
+    if (await fetch(base + "/health").then((response) => response.ok).catch(() => false)) break;
+    await setTimeout(25);
+  }
+  await client.connect(new StreamableHTTPClientTransport(new URL(base + "/mcp")));
+  assert.equal((await client.listTools()).tools.some((tool) => tool.name === "mastergo_connection_panel"), true);
+  assert.equal((await client.callTool({ name: "mastergo_connection_panel", arguments: { action: "show" } })).isError, true);
+  socket = new WebSocket(`ws://127.0.0.1:${port}/bridge?token=${token}`);
+  await once(socket, "open");
+  socket.send(JSON.stringify({ type: "hello", name: "old-plugin", capabilities: ["mastergo.invoke"] }));
+  const old = await client.callTool({ name: "mastergo_connection_panel", arguments: { action: "status" } });
+  assert.equal(old.isError, true);
+  let visible = true;
+  let requestCount = 0;
+  socket.on("message", (bytes) => {
+    const message = z.object({ id: z.string(), payload: z.object({ method: z.string(), params: z.object({ action: z.enum(["show", "hide", "status"]) }) }) }).parse(JSON.parse(String(bytes)));
+    requestCount += 1;
+    if (message.payload.method === "bridge.panel") {
+      if (message.payload.params.action === "hide") visible = false;
+      if (message.payload.params.action === "show") visible = true;
+      socket?.send(JSON.stringify({ id: message.id, type: "response", data: { code: 0, res: { connected: true, visible }, errorMsg: "" } }));
+    }
+  });
+  socket.send(JSON.stringify({ type: "hello", name: "updated-plugin", capabilities: ["mastergo.invoke", "bridge.panel"] }));
+  const hidden = await client.callTool({ name: "mastergo_connection_panel", arguments: { action: "hide" } });
+  assert.equal(hidden.isError, false);
+  assert.deepEqual(panelResult.parse(hidden.structuredContent).data, { code: 0, res: { connected: true, visible: false }, errorMsg: "" });
+  const status = await client.callTool({ name: "mastergo_connection_panel", arguments: { action: "status" } });
+  assert.deepEqual(panelResult.parse(status.structuredContent).data, { code: 0, res: { connected: true, visible: false }, errorMsg: "" });
+  const shown = await client.callTool({ name: "mastergo_connection_panel", arguments: { action: "show" } });
+  assert.deepEqual(panelResult.parse(shown.structuredContent).data, { code: 0, res: { connected: true, visible: true }, errorMsg: "" });
+  const body = JSON.stringify({ jsonrpc: "2.0", id: 1, method: "tools/call",
+    params: { name: "mastergo_connection_panel", arguments: { action: "hide" } } });
+  for (const headers of [
+    { Host: `evil.example:${port}`, Origin: `http://evil.example:${port}` },
+    { Host: `evil.example:${port}` },
+    { Origin: "https://evil.example" },
+    { Origin: "null" },
+  ]) {
+    const statusCode = await new Promise<number | undefined>((resolveResponse, reject) => {
+      const outgoing = request(base + "/mcp", {
+        method: "POST",
+        headers: { "Content-Type": "application/json", Accept: "application/json, text/event-stream",
+          "Content-Length": Buffer.byteLength(body), ...headers },
+      }, (response) => {
+        response.resume();
+        response.on("end", () => resolveResponse(response.statusCode));
+      });
+      outgoing.on("error", reject);
+      outgoing.end(body);
+    });
+    assert.equal(statusCode, 403);
+    assert.equal(requestCount, 3, "Rejected browser requests must not reach the plugin");
+    assert.equal(visible, true);
+  }
+  const invalid = await client.callTool({ name: "mastergo_connection_panel", arguments: { action: "closePlugin" } });
+  assert.equal(invalid.isError, true);
+  const denied = await client.callTool({ name: "mastergo_api_call", arguments: { method: "node.remove", params: { id: "1:02" } } });
+  assert.equal(denied.isError, true);
+  assert.equal(requestCount, 3);
+  const methods = await client.callTool({ name: "mastergo_api_list", arguments: {} });
+  assert.equal(z.object({ count: z.number() }).parse(methods.structuredContent).count, 11);
+});
diff --git a/mcp-server/test/pairing-server.test.ts b/mcp-server/test/pairing-server.test.ts
new file mode 100644
index 0000000..4a65d2c
--- /dev/null
+++ b/mcp-server/test/pairing-server.test.ts
@@ -0,0 +1,156 @@
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import { createServer } from "node:http";
+import test from "node:test";
+import { WebSocket } from "ws";
+import { z } from "zod";
+import { loadConfig } from "../src/config.js";
+import { PairingServer } from "../src/pairing-server.js";
+import { MasterGoBridgeServer } from "../src/bridge-server.js";
+import { confirmPairing } from "../src/confirm-pairing.js";
+import type { PairingDecision } from "../src/confirm-pairing.js";
+
+async function setup(lifetimeMs = 120_000, failure = false) {
+  const http = createServer();
+  http.listen(0, "127.0.0.1");
+  await once(http, "listening");
+  const address = http.address();
+  assert.ok(address && typeof address === "object");
+  const config = loadConfig({ MCP_HTTP_PORT: String(address.port), MASTERGO_BRIDGE_TOKEN: "1".repeat(64) });
+  const prompts: { code: string; signal: AbortSignal; resolve: (decision: PairingDecision) => void }[] = [];
+  const pairing = new PairingServer(config, lifetimeMs, (code, signal) => {
+    if (failure) return Promise.reject(new Error("dialog unavailable"));
+    return new Promise((resolve) => prompts.push({ code, signal, resolve }));
+  });
+  const bridge = new MasterGoBridgeServer(config);
+  const origin = new URL(config.mcpUrl).origin;
+  http.on("request", (req, res) => {
+    void pairing.handleHttp(req, res).then((handled) => {
+      if (!handled) { res.writeHead(404); res.end(); }
+    });
+  });
+  http.on("upgrade", (req, socket, head) => {
+    if (!pairing.handleUpgrade(req, socket, head) && !bridge.handleUpgrade(req, socket, head)) socket.destroy();
+  });
+  return {
+    origin, bridge, config, prompts, pairing,
+    async request() {
+      const socket = new WebSocket(origin.replace("http:", "ws:") + "/pairing/request", { origin: "null" });
+      const messages: unknown[] = [];
+      socket.on("message", (bytes) => messages.push(JSON.parse(String(bytes))));
+      const [bytes] = await once(socket, "message");
+      const info = z.object({ type: z.literal("pairing.ready"), method: z.literal("native"), code: z.string().regex(/^\d{6}$/) }).parse(JSON.parse(String(bytes)));
+      assert.equal(String(bytes).includes(config.bridgeToken!), false);
+      assert.equal(String(bytes).includes("approvalUrl"), false);
+      return { socket, info, messages };
+    },
+    async close() {
+      pairing.close();
+      await bridge.close();
+      await new Promise<void>((resolve) => http.close(() => resolve()));
+    },
+  };
+}
+
+test("native approval releases a token only to its requesting socket and authorizes the bridge", async (t) => {
+  const fixture = await setup(); t.after(() => fixture.close());
+  const request = await fixture.request();
+  assert.equal(fixture.prompts[0].code, request.info.code);
+  assert.equal(fixture.bridge.status().connected, false);
+  const other = new WebSocket(fixture.origin.replace("http:", "ws:") + "/pairing/request");
+  assert.match(String((await once(other, "error"))[0]), /403/);
+  assert.equal(fixture.prompts.length, 1);
+  const result = once(request.socket, "message");
+  fixture.prompts[0].resolve("approved");
+  const message = z.object({ type: z.literal("pairing.approved"), token: z.string() }).parse(JSON.parse(String((await result)[0])));
+  assert.equal(message.token, fixture.config.bridgeToken);
+  assert.equal(fixture.prompts[0].signal.aborted, true);
+  const socket = new WebSocket(fixture.config.bridgeUrl + "?token=" + message.token);
+  await once(socket, "open");
+  assert.equal(fixture.bridge.status().connected, true);
+  const closed = once(socket, "close"); socket.close(); await closed;
+});
+
+for (const status of ["denied", "expired", "cancelled", "unavailable"] as const) {
+  test(`native confirmation ${status} never returns credentials`, async (t) => {
+    const fixture = await setup(); t.after(() => fixture.close());
+    const request = await fixture.request();
+    const result = once(request.socket, "message");
+    fixture.prompts[0].resolve(status);
+    assert.deepEqual(JSON.parse(String((await result)[0])), { type: `pairing.${status}` });
+    assert.equal(fixture.prompts[0].signal.aborted, true);
+    assert.equal(fixture.bridge.status().connected, false);
+  });
+}
+
+test("browser requests and plugin messages cannot approve a native pairing", async (t) => {
+  const fixture = await setup(); t.after(() => fixture.close());
+  const request = await fixture.request();
+  request.socket.send(JSON.stringify({ type: "pairing.approved", decision: "approve" }));
+  for (const method of ["GET", "POST"]) {
+    const response = await fetch(fixture.origin + "/pairing/", { method });
+    assert.equal(response.status, 410);
+    assert.equal((await response.text()).includes(fixture.config.bridgeToken!), false);
+    assert.equal(response.headers.get("access-control-allow-origin"), null);
+  }
+  assert.equal(request.messages.length, 1);
+  assert.equal(fixture.bridge.status().connected, false);
+});
+
+test("closing the plugin aborts the dialog and ignores late approval", async (t) => {
+  const fixture = await setup(); t.after(() => fixture.close());
+  const request = await fixture.request();
+  const aborted = once(fixture.prompts[0].signal, "abort");
+  const closed = once(request.socket, "close"); request.socket.close(); await closed;
+  await aborted;
+  assert.equal(fixture.prompts[0].signal.aborted, true);
+  fixture.prompts[0].resolve("approved");
+  const next = await fixture.request();
+  assert.equal(next.messages.length, 1);
+  assert.equal(fixture.prompts.length, 2);
+  assert.equal(request.messages.length, 1);
+});
+
+test("pairing timeout aborts the dialog and ignores late approval", async (t) => {
+  const fixture = await setup(100); t.after(() => fixture.close());
+  const request = await fixture.request();
+  const [result] = await once(request.socket, "message");
+  assert.deepEqual(JSON.parse(String(result)), { type: "pairing.expired" });
+  assert.equal(fixture.prompts[0].signal.aborted, true);
+  fixture.prompts[0].resolve("approved");
+  await once(request.socket, "close");
+  assert.equal(request.messages.length, 2);
+});
+
+test("service shutdown dismisses the pending dialog", async (t) => {
+  const fixture = await setup(); t.after(() => fixture.close());
+  const request = await fixture.request();
+  const closed = once(request.socket, "close");
+  fixture.pairing.close();
+  await closed;
+  assert.equal(fixture.prompts[0].signal.aborted, true);
+});
+
+test("native helper failures fail closed", async (t) => {
+  const fixture = await setup(120_000, true); t.after(() => fixture.close());
+  const request = await fixture.request();
+  if (request.socket.readyState !== WebSocket.CLOSED) await once(request.socket, "close");
+  assert.deepEqual(request.messages[1], { type: "pairing.unavailable" });
+});
+
+test("native helper rejects invalid codes and already cancelled requests without UI", async () => {
+  for (const code of ["", "--help", "12345", "1234567", "123456;open", "\"123456\""]) {
+    assert.equal(await confirmPairing(code, new AbortController().signal), "unavailable");
+  }
+  assert.equal(await confirmPairing("123456", AbortSignal.abort()), "cancelled");
+});
+
+test("foreign origins and DNS-rebinding hosts cannot create a pairing", async (t) => {
+  const fixture = await setup(); t.after(() => fixture.close());
+  for (const headers of [{ Origin: "https://evil.example" }, { Origin: "null", Host: "evil.example" }]) {
+    const socket = new WebSocket(fixture.origin.replace("http:", "ws:") + "/pairing/request", { headers });
+    const [error] = await once(socket, "error");
+    assert.match(String(error), /403/);
+  }
+  assert.equal(fixture.prompts.length, 0);
+});
