@@ -0,0 +1,41 @@
+export function createConnectionPanel() {
+  let connected = false;
+  let visible = true;
+  const ui = mg.ui as UIAPI & {
+    setCloseConfirm?: (options: { enabled: boolean; message: string }) => void;
+  };
+
+  return {
+    connectionChanged(value: boolean) {
+      connected = value;
+      ui.setCloseConfirm?.({
+        enabled: value,
+        message: "关闭插件会断开连接。若要保持连接，请取消后点击“后台运行”。",
+      });
+      if (!value && !visible) {
+        ui.show();
+        visible = true;
+      }
+    },
+    invoke(params: Record<string, unknown> | undefined) {
+      const action = params?.action;
+      if (action !== "show" && action !== "hide" && action !== "status") {
+        throw new Error("Panel action must be show, hide or status.");
+      }
+      if (action === "hide") {
+        if (!connected) throw new Error("Connect before running in the background.");
+        ui.hide();
+        visible = false;
+      }
+      if (action === "show") {
+        ui.show();
+        visible = true;
+      }
+      return { connected, visible: ui.viewport?.visible ?? visible };
+    },
+    exit() {
+      ui.setCloseConfirm?.({ enabled: false, message: "" });
+      mg.closePlugin();
+    },
+  };
+}
