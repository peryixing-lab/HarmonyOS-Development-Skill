+// Keep opt-in pairing local to this plugin and document, never in design nodes.
+export function createConnectionSession() {
+  const key = `deveco.connection.v1:${mg.documentId}`;
+  let pending: Promise<unknown> = Promise.resolve();
+
+  return {
+    invoke(action: "restore" | "save" | "clear", token?: string) {
+      // Serialize storage operations so an earlier save cannot undo a disconnect.
+      const result = pending.then(async () => {
+        if (action === "clear") {
+          await mg.clientStorage.deleteAsync(key);
+          return null;
+        }
+        if (action === "save") {
+          if (!token || !/^[a-f0-9]{64}$/.test(token)) throw new Error("Invalid pairing credential");
+          await mg.clientStorage.setAsync(key, token);
+          return null;
+        }
+        const saved: unknown = await mg.clientStorage.getAsync(key);
+        return typeof saved === "string" && /^[a-f0-9]{64}$/.test(saved) ? saved : null;
+      });
+      pending = result.catch(() => undefined);
+      return result;
+    },
+  };
+}
