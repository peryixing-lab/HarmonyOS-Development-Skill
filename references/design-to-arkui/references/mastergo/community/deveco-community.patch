+    assert.equal(storage.size, 0);
+    assert.equal(runtime.elements.get('pair-button').disabled, false);
+  });
+}
+
+test('cancelled pairing ignores late approval and never reconnects', async (t) => {
+  const storage = new Map();
+  const runtime = createRuntime(storage); t.after(() => runtime.dispose());
+  await runtime.settle(); runtime.click('pair-button');
+  const pairing = runtime.sockets[0];
+  runtime.click('disconnect-button'); await runtime.settle();
+  await pairing.emit('message', { data: JSON.stringify({type:'pairing.approved',token:'1'.repeat(64)}) });
+  assert.equal(runtime.sockets.length, 1);
+  assert.equal(storage.size, 0);
+});
+
+test('pairing rejects confirmation links outside the local service', async (t) => {
+  const runtime = createRuntime(); t.after(() => runtime.dispose());
+  await runtime.settle(); runtime.click('pair-button');
+  await runtime.sockets[0].emit('message', { data: JSON.stringify({type:'pairing.ready',code:'123456',approvalUrl:'https://example.com/'}) });
+  assert.equal(runtime.sockets[0].readyState, 3);
+  assert.equal(runtime.popupAttempts.length, 0);
+});
+
+test('pairing requests a native confirmation without opening an iframe popup', async (t) => {
+  const runtime = createRuntime(); t.after(() => runtime.dispose());
+  await runtime.settle(); runtime.click('pair-button');
+  const socket = runtime.sockets[0];
+  await socket.emit('message', { data: JSON.stringify({type:'pairing.ready', code:'123456', method:'native'}) });
+  assert.equal(runtime.popupAttempts.length, 0);
+  assert.equal(runtime.elements.get('pairing-info').hidden, false);
+  assert.match(runtime.elements.get('last-event').textContent, /本机系统确认框/);
+  await socket.emit('message', { data: JSON.stringify({type:'pairing.approved', token:'1'.repeat(64)}) });
+  await runtime.settle();
+  runtime.sockets[1].emit('open');
+  assert.equal((await runtime.request({method:'mg.apiVersion'})).data.res, '1.0.0');
+});
