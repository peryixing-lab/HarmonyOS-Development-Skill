+                    document.getElementById('pairing-code').textContent = message.code;
+                    document.getElementById('pairing-info').hidden = false;
+                    setLastEvent('请在本机系统确认框中核对配对码并允许连接。');
+                    return;
+                }
+                if (message.type === 'pairing.unavailable') {
+                    stopPairing();
+                    setLastEvent('无法打开系统确认框。请在本机桌面启动服务后重试，或使用手动连接。');
+                    return;
+                }
+                if (message.type === 'pairing.approved' && /^[a-f0-9]{64}$/.test(message.token)) {
+                    stopPairing();
+                    await connectWithToken(message.token, true);
+                    return;
+                }
+                if (['pairing.denied', 'pairing.expired', 'pairing.cancelled'].includes(message.type)) {
+                    stopPairing();
+                    setLastEvent(message.type === 'pairing.expired' ? '配对已过期，请重新点击连接。' : '配对已取消。');
+                }
+            });
+            socket.addEventListener('close', () => {
+                if (pairingSocket !== socket) return;
+                stopPairing();
+                setLastEvent('配对连接已关闭，请重试或使用手动连接。');
+            });
+            socket.addEventListener('error', () => {
+                if (pairingSocket !== socket) return;
+                stopPairing();
+                setLastEvent('无法连接本机服务，请确认服务已启动并已更新。');
+            });
+        });
+
+        function stopPairing() {
+            const socket = pairingSocket;
+            pairingSocket = null;
+            if (socket) socket.close();
+            document.getElementById('pair-button').disabled = false;
+            document.getElementById('pairing-info').hidden = true;
+            document.getElementById('pairing-code').textContent = '';
+        }
+
+        document.getElementById('background-button').addEventListener('click', () => {
+            parent.postMessage({ type: 'bridge.ui.hide' }, '*');
+        });
+        document.getElementById('disconnect-button').addEventListener('click', () => stopConnection());
+
+        function stopConnection(forget = true) {
+            stopPairing();
+            connectionSerial += 1;
+            clearReconnectTimer();
+            clearHeartbeat();
+            const socket = activeSocket;
+            activeSocket = null;
+            endpoint = '';
+            reconnectAttempt = 0;
+            for (const pending of pendingPluginRequests.values()) {
+                clearTimeout(pending.timeout);
+                pending.reject(new Error('User disconnected'));
+            }
+            pendingPluginRequests.clear();
+            if (socket) socket.close(1000, 'User disconnected');
+            setStatus('Disconnected', false);
+            setLastEvent('已断开。点击“连接 DevEco Code”可重新配对。');
+            if (forget) {
+                document.getElementById('remember-connection').checked = false;
+                const serial = connectionSerial;
+                sessionRequest('clear').catch(() => {
+                    if (serial !== connectionSerial) return;
+                    setLastEvent('已断开，但无法清除本机记录。请再次点击“断开连接”重试。');
+                    document.getElementById('disconnect-button').disabled = false;
+                });
+            }
+        }
+
+        function connect() {
+            if (activeSocket && (
+                activeSocket.readyState === WebSocket.OPEN ||
+                activeSocket.readyState === WebSocket.CONNECTING
+            )) {
+                return;
+            }
+
+            clearReconnectTimer();
+            clearHeartbeat();
+
+            const serial = ++connectionSerial;
+            const ws = new WebSocket(endpoint);
+            activeSocket = ws;
+            setStatus('Connecting', false);
+            setLastEvent(`Connecting to mcp-server (${reconnectAttempt + 1})`);
+
+            ws.addEventListener('open', () => {
+                if (serial !== connectionSerial) {
+                    ws.close();
+                    return;
+                }
+
+                reconnectAttempt = 0;
+                setStatus('Connected', true);
+                setLastEvent('Connected to mcp-server');
+                ws.send(JSON.stringify({
+                    type: 'hello',
+                    name: 'mastergo-api-bridge',
+                    version: '0.2.0',
+                    capabilities: ['mastergo.invoke', 'bridge.panel']
+                }));
+                startHeartbeat(ws, serial);
+            });
+
+            ws.addEventListener('message', async (event) => {
+                if (serial !== connectionSerial) {
+                    return;
+                }
+
+                let message;
+
+                try {
+                    message = JSON.parse(event.data);
+                } catch (error) {
+                    setLastEvent('Invalid JSON message');
+                    return;
+                }
+
+                if (message.type !== 'request' || message.method !== 'mastergo.invoke') {
+                    return;
+                }
+
+                setLastEvent(formatRequestLabel(message.payload));
+
+                try {
+                    const result = await callPlugin(message.payload);
+                    ws.send(JSON.stringify({
+                        id: message.id,
+                        type: 'response',
+                        data: {
+                            code: result.code,
+                            res: result.res,
+                            errorMsg: result.errorMsg
+                        }
+                    }));
+                } catch (error) {
+                    ws.send(JSON.stringify({
+                        id: message.id,
+                        type: 'response',
+                        data: {
+                            code: -1,
+                            res: null,
+                            errorMsg: error instanceof Error ? error.message : String(error)
+                        }
+                    }));
+                }
+            });
+
+            ws.addEventListener('close', (event) => {
+                if (serial !== connectionSerial) {
+                    return;
+                }
+
+                clearHeartbeat();
+                activeSocket = null;
+                setStatus('Disconnected', false);
+                // A second instance owns the bridge now. Do not reconnect forever
+                // and repeatedly kick it off the server.
+                if (event.code === 1012 && event.reason === 'Replaced by a newer api-bridge connection') {
+                    stopConnection(false);
+                    setLastEvent('连接已交给新打开的插件实例。');
+                    return;
+                }
+                scheduleReconnect(`Disconnected (${event.code || 'unknown'})`);
+            });
+
+            ws.addEventListener('error', () => {
+                if (serial !== connectionSerial) {
+                    return;
+                }
+
+                setStatus('Connection error', false);
+                try {
+                    ws.close();
+                } catch (error) {
+                    scheduleReconnect('Connection error');
+                }
+            });
+        }
+
+        function scheduleReconnect(reason) {
+            if (!endpoint || reconnectTimer) {
+                return;
+            }
+
+            const delay = Math.min(
+                MAX_RECONNECT_DELAY_MS,
+                BASE_RECONNECT_DELAY_MS * 2 ** reconnectAttempt
+            );
+            reconnectAttempt += 1;
+            setLastEvent(`${reason}. Reconnecting in ${delay}ms`);
+            reconnectTimer = setTimeout(() => {
+                reconnectTimer = null;
+                connect();
+            }, delay);
+        }
+
+        function clearReconnectTimer() {
+            if (!reconnectTimer) {
+                return;
+            }
+
+            clearTimeout(reconnectTimer);
+            reconnectTimer = null;
+        }
+
+        function startHeartbeat(ws, serial) {
+            clearHeartbeat();
+            heartbeatTimer = setInterval(() => {
+                if (serial !== connectionSerial) {
+                    clearHeartbeat();
+                    return;
+                }
+                if (ws.readyState === WebSocket.OPEN) {
+                    return;
+                }
+
+                clearHeartbeat();
+                try {
+                    ws.close();
+                } catch (error) {
+                    scheduleReconnect('Heartbeat detected closed socket');
+                }
+            }, HEARTBEAT_INTERVAL_MS);
+        }
+
+        function clearHeartbeat() {
+            if (!heartbeatTimer) {
+                return;
+            }
+
+            clearInterval(heartbeatTimer);
+            heartbeatTimer = null;
+        }
+
+        function callPlugin(payload) {
+            return new Promise((resolve, reject) => {
+                const id = createId();
+                const timeout = setTimeout(() => {
+                    pendingPluginRequests.delete(id);
+                    reject(new Error('Plugin request timed out'));
+                }, 10000);
+
+                pendingPluginRequests.set(id, {
+                    resolve,
+                    reject,
+                    timeout
+                });
+
+                parent.postMessage({
+                    type: 'bridge.request',
+                    id,
+                    payload
+                }, '*');
+            });
+        }
+
+        window.onmessage = (event) => {
+            const message = event.data && (event.data.pluginMessage || event.data);
+
+            if (message?.type === 'bridge.session.result') {
+                const pending = pendingSessionRequests.get(message.id);
+                if (!pending) return;
+                clearTimeout(pending.timeout);
+                pendingSessionRequests.delete(message.id);
+                if (message.ok) pending.resolve(message.token);
+                else pending.reject(new Error('Local connection storage unavailable'));
+                return;
+            }
+
+            if (!message || message.type !== 'bridge.response') {
+                return;
+            }
+
+            const pending = pendingPluginRequests.get(message.id);
+            if (!pending) {
+                return;
+            }
+
+            clearTimeout(pending.timeout);
+            pendingPluginRequests.delete(message.id);
+
+            const data = message.data || {};
+            pending.resolve({
+                code: Number.isInteger(data.code) ? data.code : -1,
+                res: Object.prototype.hasOwnProperty.call(data, 'res') ? data.res : null,
+                errorMsg: typeof data.errorMsg === 'string' ? data.errorMsg : ''
+            });
+        };
+
+        function setStatus(text, connected) {
+            statusEl.textContent = text;
+            statusEl.classList.toggle('connected', connected);
+            statusEl.classList.toggle('disconnected', !connected);
+            document.getElementById('background-button').disabled = !connected;
+            document.getElementById('disconnect-button').disabled = !endpoint;
+            parent.postMessage({ type: 'bridge.connection', connected }, '*');
+        }
+
+        function setLastEvent(text) {
+            lastEventEl.textContent = text;
+        }
+
+        function formatRequestLabel(payload) {
+            if (!payload || typeof payload !== 'object') {
+                return 'Unknown request';
+            }
+
+            return String(payload.method || 'Unknown request');
+        }
+
+        function createId() {
+            if (globalThis.crypto?.randomUUID) {
+                return globalThis.crypto.randomUUID();
+            }
+
+            return `${Date.now()}-${Math.random().toString(16).slice(2)}`;
+        }
+
+        function sessionRequest(action, token) {
+            return new Promise((resolve, reject) => {
+                const id = createId();
+                const timeout = setTimeout(() => {
+                    pendingSessionRequests.delete(id);
+                    reject(new Error('Local connection storage timed out'));
+                }, 5000);
+                pendingSessionRequests.set(id, { resolve, reject, timeout });
+                parent.postMessage({ type: 'bridge.session', id, action, ...(action === 'save' ? { token } : {}) }, '*');
+            });
+        }
+
+        const restoreSerial = connectionSerial;
+        sessionRequest('restore').then((token) => {
+            if (restoreSerial !== connectionSerial || typeof token !== 'string' || !/^[a-f0-9]{64}$/.test(token)) return;
+            document.getElementById('remember-connection').checked = true;
+            endpoint = 'ws://127.0.0.1:3000/bridge?token=' + encodeURIComponent(token);
+            connect();
+        }).catch(() => {
+            if (restoreSerial === connectionSerial) setLastEvent('无法读取本机连接记录，请手动连接。');
+        });
+    </script>
+</body>
+
+</html>
