+type PanelMessage =
+  | { type: "bridge.connection"; connected: boolean }
+  | { type: "bridge.ui.hide" | "bridge.ui.exit" }
+  | { type: "bridge.session"; id: string; action: "restore" | "save" | "clear"; token?: string };
+
+export function parsePanelMessage(value: unknown): PanelMessage | null {
+  const message = unwrapPluginMessage(value);
+  if (!isRecord(message)) return null;
+  if (message.type === "bridge.session" && typeof message.id === "string") {
+    if (message.action === "restore" || message.action === "clear") {
+      return { type: "bridge.session", id: message.id, action: message.action };
+    }
+    if (message.action === "save" && typeof message.token === "string" && /^[a-f0-9]{64}$/.test(message.token)) {
+      return { type: "bridge.session", id: message.id, action: "save", token: message.token };
+    }
+  }
+  if (message.type === "bridge.connection" && typeof message.connected === "boolean") {
+    return { type: "bridge.connection" as const, connected: message.connected };
+  }
+  if (message.type === "bridge.ui.hide" || message.type === "bridge.ui.exit") {
+    return { type: message.type };
+  }
+  return null;
+}
+
 function unwrapPluginMessage(value: unknown): unknown {
